{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veilforge.dev/schemas/v4/corpus-manifest.schema.json",
  "title": "VeilForge Grant Candidate Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateVersion", "compiler", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateVersion": { "const": "4.0.0-gc.1" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "const": "solc" },
        "version": { "const": "0.8.24" },
        "mode": { "const": "exact" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "classification", "behavior", "sensitiveClasses", "sinks", "tags", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^(PAY|TRE|CRD)-(POS|NEG|ADV)-[0-9]{3}$" },
          "domain": { "enum": ["arc-payments", "arc-treasury", "arc-private-credit"] },
          "classification": { "enum": ["positive", "negative", "adversarial"] },
          "behavior": { "type": "string", "minLength": 12 },
          "sensitiveClasses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "sinks": { "type": "array", "items": { "enum": ["public-storage-getter", "event", "calldata", "return", "revert-custom-error", "external-call", "metadata-uri"] }, "uniqueItems": true },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "path": { "type": "string", "pattern": "^tests/corpus/(arc-payments|arc-treasury|arc-private-credit)/(positive|negative|adversarial)/.+$" }
        }
      }
    }
  }
}
