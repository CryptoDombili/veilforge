{
  "name": "veilforge",
  "version": "3.2.2",
  "private": true,
  "type": "module",
  "description": "VeilForge Privacy Operating System \u2014 deterministic, local-first privacy engineering for Solidity projects on Arc.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:spec": "node --test tests/spec/*.test.mjs",
    "test:corpus": "node --test tests/spec/corpus-contract.test.mjs",
    "test:identity-vectors": "node --test tests/spec/identity-vectors.test.mjs",
    "test:hash-vectors": "node --test tests/spec/report-hash-vectors.test.mjs",
    "test:determinism": "node --test tests/spec/identity-vectors.test.mjs tests/spec/report-hash-vectors.test.mjs",
    "test:v4-frontend": "node --test tests/v4/frontend/compiler-provider.test.mjs tests/v4/frontend/standard-json.test.mjs tests/v4/frontend/compile-project.test.mjs tests/v4/frontend/import-graph.test.mjs tests/v4/frontend/ast-index.test.mjs tests/v4/frontend/source-locations.test.mjs",
    "test:v4-corpus-compile": "node --test tests/v4/corpus-compile.test.mjs",
    "test:v4-frontend-determinism": "node --test tests/v4/frontend/determinism.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check": "npm run preflight",
    "scan:demo": "node packages/analyzer/cli.mjs scan examples/vulnerable-payroll --format text",
    "scan:json": "node packages/analyzer/cli.mjs scan examples/vulnerable-payroll --format json",
    "manifest:write": "node scripts/release-manifest.mjs --write",
    "manifest:check": "node scripts/release-manifest.mjs --check"
  },
  "dependencies": {
    "solc": "0.8.24"
  }
}
